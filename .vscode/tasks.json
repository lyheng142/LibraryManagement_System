{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "clear": true
            },
            "problemMatcher": "$gcc",
            "linux": {
                "command": "bash",
                "args": ["${workspaceFolder}/build_linux.sh"],
                "options": { "cwd": "${workspaceFolder}" }
            },
            "osx": {
                "command": "bash",
                "args": ["${workspaceFolder}/build_linux.sh"],
                "options": { "cwd": "${workspaceFolder}" }
            },
            "windows": {
                "command": "cmd",
                "args": ["/c", "${workspaceFolder}\\build_windows.bat"],
                "options": { "cwd": "${workspaceFolder}" }
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": "Build",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "new",
                "clear": true
            },
            "linux": {
                "command": "${workspaceFolder}/build/library",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "osx": {
                "command": "${workspaceFolder}/build/library",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "windows": {
                "command": "cmd",
                "args": ["/c", "${workspaceFolder}\\build\\library.exe"],
                "options": { "cwd": "${workspaceFolder}" }
            }
        }
    ]
}
